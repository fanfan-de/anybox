{
  "name": "anyboxagent",
  "private": true,
  "devDependencies": {
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "@types/bun": "1.3.11",
    "@types/node": "^25.5.0",
    "@types/which": "^3.0.4",
    "@types/xdg-basedir": "^4.0.2",
    "@types/yargs": "^17.0.35",
    "typedoc": "^0.28.18"
  },
  "peerDependencies": {
    "typescript": "^6.0.2"
  },
  "dependencies": {
    "@ai-sdk/provider": "^4.0.4",
    "@anybox/platform": "workspace:*",
    "@anybox/shared": "workspace:*",
    "@jitl/quickjs-singlefile-cjs-release-sync": "0.32.0",
    "@modelcontextprotocol/client": "2.0.0",
    "@opentui/core": "^0.1.90",
    "@opentui/solid": "^0.1.90",
    "@types/ssh2": "^1.15.5",
    "ai": "^7.0.44",
    "fuzzysort": "^3.1.0",
    "gray-matter": "^4.0.3",
    "hono": "^4.12.9",
    "jsonc-parser": "^3.3.1",
    "node-pty": "^1.1.0",
    "pyright": "^1.1.409",
    "quickjs-emscripten-core": "0.32.0",
    "remeda": "^2.33.6",
    "ssh2": "^1.17.0",
    "typescript-language-server": "^4.4.0",
    "vitest": "^4.1.2",
    "which": "^6.0.1",
    "xdg-basedir": "^5.1.0",
    "yargs": "^18.0.0",
    "zod": "^4.3.6"
  },
  "imports": {
    "#acp/*": "./src/acp/*",
    "#agent/*": "./src/agent/*",
    "#automation/*": "./src/automation/*",
    "#auth/*": "./src/auth/*",
    "#bun/*": "./src/bun/*",
    "#bus/*": "./src/bus/*",
    "#cli/*": "./src/cli/*",
    "#command/*": "./src/command/*",
    "#config/*": "./src/config/*",
    "#database/*": "./src/database/*",
    "#eval/*": "./src/eval/*",
    "#flag/*": "./src/flag/*",
    "#global/*": "./src/global/*",
    "#id/*": "./src/id/*",
    "#installation/*": "./src/installation/*",
    "#permission/*": "./src/permission/*",
    "#project/*": "./src/project/*",
    "#prompts/*": "./src/prompts/*",
    "#provider/*": "./src/provider/*",
    "#scheduler/*": "./src/scheduler/*",
    "#server/*": "./src/server/*",
    "#session/*": "./src/session/*",
    "#skill/*": "./src/skill/*",
    "#shell/*": "./src/shell/*",
    "#snapshot/*": "./src/snapshot/*",
    "#mcp/*": "./src/mcp/*",
    "#tool/*": "./src/tool/*",
    "#util/*": "./src/util/*",
    "#*": "./src/*"
  },
  "scripts": {
    "dev:server": "bun run src/server/start.ts",
    "docs": "typedoc",
    "eval": "bun run src/eval/cli.ts",
    "test:bun": "bun test Test/bun.runtime.test.ts",
    "test:provider": "bun test Test/provider.openai-compatible.test.ts && bun test Test/provider.openai-codex-models.test.ts && bun test Test/provider.deepseek-runtime-adapter.test.ts && bun test Test/provider.openrouter-provider.test.ts && bun test Test/provider.modelsdev-sdk-adapter.test.ts && bun test Test/provider.anybox-provider.test.ts && bun test Test/bun.runtime.test.ts",
    "test:prompt": "bun test Test/prompt.e2e.test.ts",
    "test:server": "bun Test/run-server-tests.ts",
    "test:server-prompt-e2e": "bun test Test/server.prompt.e2e.test.ts",
    "test:shell": "bun test Test/shell.task-registry.test.ts Test/pty.runtime.test.ts Test/server.pty.test.ts Test/terminal-output.test.ts && bun test Test/tool.contract.test.ts",
    "test:tool": "bun test Test/javascript-runtime.test.ts Test/tool.exec.test.ts Test/tool.selection.test.ts Test/tool.search.test.ts Test/tool.contract.test.ts Test/tool.processor.test.ts Test/tool.apply-patch.test.ts",
    "test:tool:e2e": "bun test Test/tool.real-llm.e2e.test.ts",
    "test:tool:all": "bun run test:tool && bun run test:tool:e2e"
  }
}
