{
  "name": "@anybox/mobile-update-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "tsx --test src/**/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.6",
    "hono": "^4.12.29"
  },
  "devDependencies": {
    "@types/node": "^25.0.2",
    "tsx": "^4.23.0",
    "typescript": "^5.9.3"
  }
}
