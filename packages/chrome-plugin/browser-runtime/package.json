{
  "name": "anybox-chrome-browser-runtime",
  "version": "0.3.0",
  "private": true,
  "description": "TypeScript browser client runtime bundled into the Anybox Chrome plugin.",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit -p tsconfig.json && node ./build.mjs",
    "test": "tsc --noEmit -p tsconfig.json && node ./build.mjs && node --test ./Test/*.test.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@anybox/shared": "workspace:*",
    "@types/node": "^25.5.0",
    "esbuild": "^0.27.2",
    "typescript": "^5.9.3"
  }
}
