{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node", "vite/client", "vitest/globals"],
    "noEmit": true,
    "paths": {
      "@anybox/shared": ["../shared/src/index.ts"],
      "@anybox/shared/*": ["../shared/src/*"],
      "@anybox/platform": ["../platform/src/index.ts"],
      "dockview-react": ["../dockview-react/src/index.ts"],
      "dockview": ["../dockview/src/index.ts"],
      "dockview-core": ["../dockview-core/src/index.ts"],
      "dockview-modules": ["../dockview-modules/src/index.ts"],
      "react": ["./node_modules/@types/react"],
      "react/*": ["./node_modules/@types/react/*"],
      "react-dom": ["./node_modules/@types/react-dom"],
      "react-dom/*": ["./node_modules/@types/react-dom/*"],
      "zod": ["../anyboxagent/node_modules/zod"]
    }
  },
  "include": [
    "electron.vite.config.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.d.ts",
    "vitest.config.ts",
    "../shared/src/**/*.ts",
    "../platform/src/**/*.ts",
    "../dockview-core/src/**/*.ts",
    "../dockview-modules/src/**/*.ts",
    "../dockview/src/**/*.ts",
    "../dockview-react/src/**/*.ts",
    "../dockview-react/src/**/*.tsx"
  ],
  "exclude": [
    "../shared/src/**/*.test.ts",
    "../platform/src/**/*.test.ts",
    "../dockview-core/src/**/__tests__/**/*",
    "../dockview-modules/src/**/__tests__/**/*",
    "../dockview/src/**/__tests__/**/*",
    "../dockview-react/src/**/__tests__/**/*"
  ]
}
