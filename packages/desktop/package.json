{
  "name": "anybox-desktop-agent",
  "version": "0.1.34",
  "private": true,
  "description": "Anybox desktop AI agent workspace",
  "author": {
    "name": "fanfan-de",
    "email": "fanfan-de@users.noreply.github.com"
  },
  "homepage": "https://github.com/fanfan-de/anybox",
  "license": "MIT",
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "build:dockview-css": "corepack pnpm --filter dockview-core run build:css && corepack pnpm --filter dockview-react run build:css",
    "dev": "corepack pnpm run build:dockview-css && node ./scripts/dev.mjs",
    "dev:debug": "corepack pnpm run build:dockview-css && node ./scripts/dev.mjs --agent-log-level=DEBUG",
    "dev:info": "corepack pnpm run build:dockview-css && node ./scripts/dev.mjs --agent-log-level=INFO",
    "dev:warn": "corepack pnpm run build:dockview-css && node ./scripts/dev.mjs --agent-log-level=WARN",
    "dev:error": "corepack pnpm run build:dockview-css && node ./scripts/dev.mjs --agent-log-level=ERROR",
    "appearance:promote": "node ./scripts/promote-appearance-theme.mjs",
    "build:cinema-web": "corepack pnpm --filter anybox-cinema-web build",
    "build:plugin-release": "node ./scripts/prepare-plugin-release.mjs",
    "build:agent-runtime": "node ./scripts/prepare-agent-runtime.mjs",
    "build:monitor": "corepack pnpm --filter anybox-monitor build",
    "build": "corepack pnpm run build:dockview-css && corepack pnpm run build:cinema-web && corepack pnpm run build:plugin-release && corepack pnpm run build:agent-runtime && corepack pnpm run build:monitor && electron-vite build",
    "icons:generate": "node ./scripts/generate-app-icons.mjs",
    "verify:media-runtime": "node ./scripts/verify-media-runtime.mjs",
    "verify:media-runtime:release": "node ./scripts/verify-media-runtime.mjs --release-strict",
    "test:media-runtime-lock": "node --test ./scripts/verify-media-runtime.test.mjs ./scripts/verify-deliver-release-gates.test.mjs ./scripts/media-runtime-candidate.test.mjs",
    "test:thread-chromium": "playwright test --config playwright.thread.config.ts",
    "media-runtime:promote-candidate": "node ./scripts/promote-media-runtime-candidate.mjs",
    "verify:agent-runtime": "node ./scripts/verify-agent-runtime.mjs",
    "verify:agent-runtime:release": "node ./scripts/verify-agent-runtime.mjs --release-strict",
    "verify:plugin-runtime-catalog": "node ./scripts/verify-plugin-runtime-catalog.mjs",
    "verify:plugin-release": "node ./scripts/verify-plugin-release.mjs",
    "verify:deliver-restart-evidence": "node ./scripts/verify-deliver-restart-evidence.mjs",
    "verify:deliver-release-matrix": "node ./scripts/verify-deliver-release-matrix.mjs",
    "verify:deliver-release-approval": "node ./scripts/verify-deliver-release-approval.mjs",
    "dist:deliver-preview": "node ./scripts/dist-deliver-preview.mjs",
    "dist:deliver-beta": "node ./scripts/dist-deliver-preview.mjs --beta",
    "dist": "corepack pnpm run build && corepack pnpm run verify:agent-runtime:release && corepack pnpm run verify:plugin-runtime-catalog && corepack pnpm run icons:generate && node ./scripts/dist-release.mjs",
    "dist:publish": "corepack pnpm run build && corepack pnpm run verify:agent-runtime:release && corepack pnpm run verify:plugin-runtime-catalog && corepack pnpm run icons:generate && node ./node_modules/electron-builder/cli.js --publish always",
    "dist:dir": "corepack pnpm run build && corepack pnpm run verify:agent-runtime:release && corepack pnpm run verify:plugin-runtime-catalog && corepack pnpm run icons:generate && node ./node_modules/electron-builder/cli.js --dir --publish never",
    "i18n:audit": "node ./scripts/i18n-audit.mjs",
    "i18n:audit:update-baseline": "node ./scripts/i18n-audit.mjs --update-baseline",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@anybox/platform": "workspace:*",
    "@anybox/shared": "workspace:*",
    "@lexical/history": "^0.43.0",
    "@lexical/plain-text": "^0.43.0",
    "@lexical/react": "^0.43.0",
    "@lexical/utils": "^0.43.0",
    "@tanstack/react-virtual": "^3.14.5",
    "@vscode/codicons": "0.0.45",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "dompurify": "^3.4.5",
    "electron-updater": "^6.8.3",
    "hast-util-to-jsx-runtime": "^2.3.6",
    "lexical": "^0.43.0",
    "lucide-react": "^1.8.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "shiki": "^4.2.0",
    "unified": "^11.0.5",
    "ws": "8.20.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@ibm/plex-mono": "2.5.0",
    "@ibm/plex-sans": "1.1.0",
    "@ibm/plex-sans-sc": "1.1.0",
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/hast": "^3.0.4",
    "@types/mdast": "^4.0.4",
    "@types/node": "^24.6.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "^5.1.2",
    "electron": "^42.5.2",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "jsdom": "^27.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.0.8"
  }
}
