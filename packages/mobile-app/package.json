{
  "name": "anybox-mobile-app",
  "version": "0.3.0",
  "private": true,
  "main": "expo-router/entry",
  "expo": {
    "autolinking": {
      "android": {
        "legacy_shallowReactNativeLinking": true,
        "exclude": [
          "@react-native-masked-view/masked-view",
          "react-native-drawer-layout",
          "react-native-gesture-handler",
          "react-native-reanimated",
          "react-native-worklets"
        ]
      }
    }
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "PATH=\"$HOME/.gem/ruby/2.6.0/bin:$PATH\" RUBYOPT='-rlogger' expo run:ios",
    "android:dev": "expo run:android",
    "ios:dev": "PATH=\"$HOME/.gem/ruby/2.6.0/bin:$PATH\" RUBYOPT='-rlogger' expo run:ios",
    "ios:metro": "expo start --dev-client --host localhost --port 8081",
    "ios:open": "node ./scripts/ios-open-dev-client.mjs",
    "ios:simulator": "PATH=\"$HOME/.gem/ruby/2.6.0/bin:$PATH\" RUBYOPT='-rlogger' expo run:ios",
    "android:setup": "node ./scripts/android-toolchain-windows.mjs",
    "android:build:debug": "node ./scripts/build-android-debug.mjs",
    "android:build:release": "node ./scripts/build-android-release.mjs",
    "android:install:debug": "node ./scripts/install-android-debug.mjs",
    "android:smoke:debug": "node ./scripts/android-launch-smoke.mjs",
    "android:smoke:bridge": "node ./scripts/android-real-bridge-smoke.mjs",
    "android:smoke:pairing": "node ./scripts/android-pairing-smoke.mjs",
    "android:delivery-check": "node ./scripts/android-delivery-check.mjs",
    "android:handoff-check": "node ./scripts/android-handoff-check.mjs",
    "keys:init": "node ./scripts/mobile-keys-init.mjs",
    "fingerprint:record": "node ./scripts/record-mobile-native-baseline.mjs",
    "fingerprint:check": "node ./scripts/record-mobile-native-baseline.mjs --check",
    "update:preview": "node ./scripts/publish-mobile-ota.mjs preview",
    "update:promote": "node ./scripts/promote-mobile-ota.mjs",
    "update:rollback": "node ./scripts/rollback-mobile-ota.mjs",
    "release:publish": "node ./scripts/publish-mobile-release.mjs",
    "release:github:prepare": "node ./scripts/prepare-github-mobile-release.mjs",
    "doctor": "node ./scripts/mobile-doctor.mjs",
    "smoke": "node ./scripts/mobile-smoke.mjs",
    "test:message": "tsx ./scripts/message-merge-regression.mjs",
    "test:update-tools": "node --test ./scripts/lib/*.test.mjs && tsx --test ./scripts/update-policy.test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anybox/shared": "workspace:*",
    "@expo/metro-runtime": "~56.0.18",
    "@expo/vector-icons": "^15.1.1",
    "expo": "~56.0.18",
    "expo-application": "~56.0.3",
    "expo-camera": "~56.0.8",
    "expo-constants": "~56.0.22",
    "expo-linking": "~56.0.16",
    "expo-router": "~56.2.17",
    "expo-secure-store": "56.0.4",
    "expo-status-bar": "56.0.4",
    "expo-updates": "~56.0.23",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-markdown-renderer": "^4.1.1",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-sse": "1.2.1"
  },
  "devDependencies": {
    "@expo/fingerprint": "~0.19.9",
    "@types/react": "19.2.16",
    "babel-preset-expo": "56.0.14",
    "tsx": "^4.20.6",
    "typescript": "6.0.3"
  }
}
