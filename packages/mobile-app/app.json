{
  "expo": {
    "name": "Anybox Mobile",
    "slug": "anybox-mobile",
    "scheme": "anybox-mobile",
    "version": "0.3.0",
    "icon": "./assets/icon.png",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "enabled": true,
      "url": "https://updates.anybox.com.cn/v1/manifest",
      "checkAutomatically": "ON_ERROR_RECOVERY",
      "fallbackToCacheTimeout": 0,
      "requestHeaders": {
        "expo-channel-name": "production"
      }
    },
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0D1420"
    },
    "android": {
      "package": "com.anybox.mobile",
      "versionCode": 7,
      "usesCleartextTraffic": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0D1420"
      },
      "permissions": [
        "INTERNET",
        "CAMERA",
        "REQUEST_INSTALL_PACKAGES"
      ]
    },
    "ios": {
      "bundleIdentifier": "com.anybox.mobile",
      "buildNumber": "7",
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Allow Anybox Mobile to scan desktop pairing QR codes.",
        "NSLocalNetworkUsageDescription": "Allow Anybox Mobile to connect to your desktop bridge on the local network.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "./plugins/with-android-lan-cleartext",
      "./plugins/with-android-release-signing",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Anybox Mobile to scan desktop pairing QR codes."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "anyboxMobileReleaseUrl": "https://download.anybox.com.cn/mobile/android/version.json",
      "anyboxMobileReleaseSignatureUrl": "https://download.anybox.com.cn/mobile/android/version.sig",
      "anyboxMobileUpdateChannel": "production",
      "anyboxMobileOtaKeyId": "anybox-mobile-2026",
      "anyboxMobileMinimumVersionCode": 7,
      "anyboxMobileGitHubRepository": "fanfan-de/anybox",
      "anyboxMobileGitHubReleaseTagPrefix": "mobile-v",
      "anyboxMobileGitHubApkAssetName": "anybox-mobile.apk",
      "anyboxMobileGitHubManifestAssetName": "anybox-mobile-release.json",
      "anyboxMobileGitHubManifestSignatureAssetName": "anybox-mobile-release.json.sig",
      "anyboxRelayUrl": "https://anybox.com.cn"
    }
  }
}
