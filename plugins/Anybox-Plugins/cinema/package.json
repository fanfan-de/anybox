{
  "name": "@anybox/cinema-plugin",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./contracts": "./src/contracts/cinema.ts",
    "./contracts/timeline": "./src/contracts/cinema-timeline.ts",
    "./contracts/render": "./src/contracts/cinema-render.ts",
    "./contracts/subtitles": "./src/contracts/cinema-subtitles.ts"
  },
  "imports": {
    "#auth/provider-auth.ts": "./src/platform/provider-auth.ts",
    "#cinema/*": "./src/domain/*",
    "#config/config.ts": "./src/storage/settings.ts",
    "#env/compat.ts": "./src/platform/env.ts",
    "#global/global.ts": "./src/platform/global.ts",
    "#model/registry.ts": "./src/providers/openai-compatible.ts",
    "#model/runtime.ts": "./src/providers/openai-compatible.ts",
    "#model/types.ts": "./src/providers/openai-compatible.ts",
    "#platform/native-helper.ts": "./src/platform/native-helper.ts",
    "#platform/toolchain.ts": "./src/platform/toolchain.ts",
    "#project/instance.ts": "./src/platform/instance.ts",
    "#platform/workspace-uri.ts": "./src/platform/workspace-uri.ts",
    "#project/project.ts": "./src/storage/projects.ts",
    "#provider/provider.ts": "./src/providers/provider-error.ts",
    "#server/base-url.ts": "./src/api/base-url.ts",
    "#server/error.ts": "./src/api/error.ts",
    "#server/http.ts": "./src/api/http.ts",
    "#server/routes/cinema-assets.ts": "./src/api/cinema-assets.ts",
    "#server/routes/cinema.ts": "./src/api/cinema-routes.ts",
    "#server/server.ts": "./src/api/app.ts",
    "#server/types.ts": "./src/api/types.ts",
    "#server/usecases/cinema.ts": "./src/api/cinema.ts",
    "#server/usecases/model-list-cache.ts": "./src/providers/openai-compatible.ts",
    "#session/support/image-assets.ts": "./src/platform/image-assets.ts",
    "#session/support/prompt-presets.ts": "./src/storage/prompt.ts",
    "#util/lock.ts": "./src/storage/lock.ts",
    "#util/log.ts": "./src/platform/log.ts"
  },
  "scripts": {
    "build": "bun run build.mjs",
    "build:web": "vite build",
    "build:runtime": "bun build ./src/server.ts --target=bun --outdir ./runtime --entry-naming server.js",
    "build:mcp": "bun build ./src/mcp/server.ts --target=bun --outdir ./mcp --entry-naming server.js",
    "build:helper": "node ./native/build-helper.mjs",
    "helper:verify-signature": "node ./native/verify-helper-signature.mjs",
    "helper:verify-signature:validation": "node ./native/verify-helper-signature.mjs --allow-unsigned-validation",
    "helpers:assemble": "node ./native/assemble-helper-manifest.mjs",
    "helpers:assemble:validation": "node ./native/assemble-helper-manifest.mjs --allow-unsigned-validation",
    "helpers:check": "node ./native/assemble-helper-manifest.mjs --check",
    "check:decoupling": "node ./check-decoupling.mjs",
    "package": "node ./package-plugin.mjs",
    "package:smoke": "bun ./package-smoke.ts",
    "package:playwright-smoke": "playwright test --config ./package-playwright.config.ts",
    "package:release": "node ./package-plugin.mjs --release",
    "package:matrix-validation": "node ./package-plugin.mjs --release --allow-unsigned-validation",
    "dev": "vite",
    "preview": "vite preview",
    "start:standalone": "bun ./runtime/server.js --standalone",
    "test": "bun test ./Test ./src/**/*.test.ts",
    "test:web": "vitest run src/web",
    "test:e2e": "playwright test",
    "test:toolchain": "node --test ./toolchain/scripts/verify-media-runtime.test.mjs ./toolchain/scripts/media-runtime-candidate.test.mjs",
    "toolchain:verify": "node ./toolchain/scripts/verify-media-runtime.mjs",
    "toolchain:promote-candidate": "node ./toolchain/scripts/promote-media-runtime-candidate.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "3.0.18",
    "@tanstack/react-query": "^5.90.12",
    "@tanstack/react-virtual": "3.14.5",
    "@xyflow/react": "^12.9.3",
    "ai": "^7.0.44",
    "fuzzysort": "^3.1.0",
    "hono": "^4.12.8",
    "lucide-react": "^1.8.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "10.1.0",
    "remark-breaks": "4.0.0",
    "tar": "^7.5.2",
    "zod": "^4.1.13",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/bun": "^1.3.9",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.2",
    "axe-core": "^4.12.1",
    "fflate": "^0.8.2",
    "jsdom": "^27.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.1.2"
  }
}
